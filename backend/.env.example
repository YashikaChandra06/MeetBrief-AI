# MeetBrief AI - Backend Environment Configuration

# 1. Tavily API Key (Only manual requirement)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# 2. Local Ollama Settings (Optional / Auto-detected)
# Ollama runs locally without any API key or subscription
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# 3. Server Configuration
PORT=5000
NODE_ENV=development

